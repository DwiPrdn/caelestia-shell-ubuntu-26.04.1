# ── Oh-My-Zsh ──────────────────────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""  # Using Starship instead

# Plugins
plugins=(
    git
    sudo                  # press ESC twice to prefix last cmd with sudo
    zsh-autosuggestions
    zsh-syntax-highlighting
    fzf
    z                     # built-in z (also have zoxide below)
)

source $ZSH/oh-my-zsh.sh

# ── Starship Prompt ─────────────────────────────────────────────────────────
eval "$(starship init zsh)"

# ── Zoxide (smarter cd) ─────────────────────────────────────────────────────
eval "$(zoxide init zsh --cmd cd)"

# ── FZF ─────────────────────────────────────────────────────────────────────
eval "$(fzf --zsh 2>/dev/null)" || source /usr/share/doc/fzf/examples/key-bindings.zsh 2>/dev/null
export FZF_DEFAULT_OPTS="
  --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8
  --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc
  --color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8
  --height=40% --border=rounded --layout=reverse"

# ── Aliases ─────────────────────────────────────────────────────────────────
# Better ls
alias ls='lsd'
alias l='lsd -l'
alias la='lsd -la'
alias lt='lsd --tree'

# Better cat
alias cat='bat --pager=never'
alias catp='bat'           # with pager

# Navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# Git shortcuts
alias g='git'
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git log --oneline --graph --decorate'
alias gd='git diff'

# System
alias update='sudo apt update && sudo apt upgrade -y'
alias ports='ss -tulpn'
alias myip='curl -s ifconfig.me'
alias df='df -h'
alias du='du -h'
alias free='free -h'

# Hyprland
alias hconf='$EDITOR ~/.config/hypr/hyprland.conf'
alias cconf='$EDITOR ~/.config/caelestia/shell.json'
alias hreload='hyprctl reload'
alias hlog='journalctl --user -u caelestia-shell.service -f'

# ── Environment ─────────────────────────────────────────────────────────────
export EDITOR=nano
export VISUAL=nano
export PAGER='bat --paging=always'
export MANPAGER="sh -c 'col -bx | bat -l man -p'"
export PATH="$HOME/.local/bin:$PATH"
export QML_IMPORT_PATH=/usr/lib/qt6/qml

# ── History ─────────────────────────────────────────────────────────────────
HISTSIZE=10000
SAVEHIST=10000
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt SHARE_HISTORY

# ── Misc ────────────────────────────────────────────────────────────────────
# Autosuggestions style
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#585b70"
ZSH_AUTOSUGGEST_STRATEGY=(history completion)

# Syntax highlighting
typeset -A ZSH_HIGHLIGHT_STYLES
ZSH_HIGHLIGHT_STYLES[command]='fg=#a6e3a1,bold'
ZSH_HIGHLIGHT_STYLES[alias]='fg=#a6e3a1,bold'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=#89dceb,bold'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=#f38ba8'
ZSH_HIGHLIGHT_STYLES[path]='fg=#cdd6f4,underline'
